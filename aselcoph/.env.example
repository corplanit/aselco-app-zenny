APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mobile API (Ionic Vite)
SANCTUM_TOKEN_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASELCO_LEDGER_URL=https://coop.eduisbotswave.com/AselcoCollection/GetConsumersLeger
ASELCO_LEDGER_TIMEOUT=20

# AST wallet (1 AST = 1 PHP). Loads at or above the threshold need a second approver.
AST_PHP_RATE=1
AST_LOAD_APPROVAL_THRESHOLD=10000
AST_MAX_LOAD_AMOUNT=100000
AST_LOAD_WALLET_ROLES=Administrator,administrator,Customer Service

# Ticket SLA / assignment (scheduler: * * * * * php artisan schedule:run)
TICKET_SLA_SWEEP_MINUTES=5
TICKET_SECOND_TIER_AFTER_MINUTES=30
TICKET_AUTO_ASSIGN_STRATEGY=round_robin
TICKET_ATTACHMENT_MAX_KB=10240
TICKET_ATTACHMENT_DISK=local

# Queue: production MUST NOT be sync. Workers: php artisan queue:work --tries=5
# QUEUE_CONNECTION=database

# FCM (leave empty to skip push; in-app notifications still persist)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# SMS webhook (leave empty to skip SMS; mail + in-app still send)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER=ASELCO

# OpenAI (server-side only — never put this in Ionic / VITE_ env)
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
OPENAI_RETRIES=2
OPENAI_RETRY_MS=250
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.3
AI_HISTORY_MESSAGES=12
AI_MAX_USER_CHARS=2000
# RAG knowledge base
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.18
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=80
RAG_LEXICAL_WEIGHT=0.6
RAG_VECTOR_WEIGHT=0.4
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_TIMEOUT=20
RAG_MAX_UPLOAD_KB=2048
RAG_DISK=local

# Ticket AI assistance (advisory; does not replace routing/SLA)
TICKET_AI_ENABLED=true
TICKET_AI_AUTO_ANALYZE=true
TICKET_AI_AUTO_SEND=false
TICKET_AI_AUTO_SEND_MIN_CONFIDENCE=0.85
TICKET_AI_QUEUE=default
